 ["쌀국수 퍼(phở)의 고향으로 흔히 꼽히는 곳은 어디일까요?",["북부","남부 메콩강","제주도","중부 산악"],0,"북부 하노이 일대에서 시작된 음식으로 알려져 있어요."],
 ["베트남은 한국보다 시간이 어떨까요?",["2시간 빨라요","2시간 느려요","똑같아요","7시간 느려요"],1,"베트남은 UTC+7, 한국은 UTC+9라서 한국이 2시간 빨라요."],
 ["중추절(Tết Trung Thu)의 주인공은 누구일까요?",["어린이","군인","농부만","선생님만"],0,"등을 들고 사자춤을 보고 월병을 먹는 어린이 명절이에요."],
 ["ông ngoại는 누구를 부르는 말일까요?",["친할아버지","외할아버지","큰아버지","삼촌"],1,"ngoại는 어머니 쪽이에요. 아버지 쪽은 nội예요."],
 ["원통형 설 음식 반떼(bánh tét)를 더 즐겨 먹는 곳은 어디일까요?",["북부","남부","모두 같아요","먹지 않아요"],1,"북부는 네모난 반쯩, 남부는 길쭉한 원통형 반떼를 많이 먹어요."]
];
var qi=0,qs=0,qOrder=[];
function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t}return a}
function quiz(){
  var q=Q[qi],box=$("quiz");
  if(!q){
    box.innerHTML='<p class="result">'+Q.length+"문제 중 "+qs+"문제를 맞혔어요!</p><p class=\"muted\">"+(qs===Q.length?"모두 맞혔어요. 이제 베트남 박사님이에요.":qs>=6?"아주 잘했어요. 틀린 문제는 해당 장에서 다시 읽어 보세요.":"괜찮아요. 책을 다시 읽고 한 번 더 도전해 보세요.")+'</p><button class="btn primary" id="qre">다시 풀기</button>';
    $("qre").onclick=function(){qi=0;qs=0;quiz()};return;
  }
  qOrder=shuffle(q[1].map(function(_,i){return i}));
  var h='<p class="muted" style="margin:0 0 6px;font-size:14px;font-weight:700">'+(qi+1)+" / "+Q.length+'</p><p style="font-weight:700;font-size:18px;margin-bottom:12px"></p><div id="opts"></div><div id="fb"></div>';
  box.innerHTML=h;box.querySelector("p+p").textContent=q[0];
  qOrder.forEach(function(oi){
    var b=document.createElement("button");b.className="opt";b.textContent=q[1][oi];
    b.addEventListener("click",function(){pick(b,oi)});$("opts").appendChild(b);
  });
}
function pick(btn,oi){
  var q=Q[qi],ok=oi===q[2];
  if(ok)qs++;
  var all=$("opts").querySelectorAll("button");
  all.forEach(function(b){b.disabled=true;if(b.textContent===q[1][q[2]])b.classList.add("ok")});
  if(!ok)btn.classList.add("no");
  var fb=$("fb");
  fb.innerHTML='<div class="note '+(ok?"green":"red")+'"><p><b>'+(ok?"정답이에요!":"아쉬워요.")+"</b> </p></div>";
  fb.querySelector("p").appendChild(document.createTextNode(q[3]));
  var n=document.createElement("button");n.className="btn primary";n.textContent=qi===Q.length-1?"결과 보기":"다음 문제";
  n.onclick=function(){qi++;quiz()};fb.appendChild(n);n.focus();
}
quiz();

/* ---------- ask cards ---------- */
var ASK=["고향집은 어떤 모습이었어요?","어릴 때 가장 좋아했던 음식은 뭐예요?","고향에서 설에는 가족이 무엇을 했어요?","어릴 때 부르던 노래나 놀이가 있어요?","우리 가족 이름에는 어떤 뜻이 있어요?","한국에 와서 가장 신기했던 건 뭐예요?","고향에서 가장 그리운 장소는 어디예요?","할머니와 할아버지는 어떤 분이셨어요?","한국에 와서 가장 낯설었던 음식은 뭐였어요?","우리 아이에게 꼭 알려 주고 싶은 베트남 말은 뭐예요?","학교 가는 길은 어땠어요?","베트남의 날씨 중 가장 그리운 건 뭐예요?"];
var lastAsk=-1;
$("askBtn").onclick=function(){
  var i;do{i=Math.floor(Math.random()*ASK.length)}while(i===lastAsk);
  lastAsk=i;$("askOut").textContent=ASK[i];$("askBtn").textContent="다른 질문 뽑기";
};

/* ---------- checklist ---------- */
var TODO=["베트남어 인사말 세 가지 외우기","가족 호칭표를 냉장고에 붙이기","주말에 고이꾸온 만들어 보기","베트남 가족과 영상통화로 \"Ăn cơm chưa?\" 묻기","달력에 음력 설 날짜 표시하기","베트남 동요를 함께 들어 보기","우리 가족 이름의 뜻 이야기하기"];
var KEY="vn-book-todo",done={};
try{done=JSON.parse(localStorage.getItem(KEY)||"{}")||{}}catch(e){done={}}
var td=$("todo");
TODO.forEach(function(t,i){
  var d=document.createElement("div");d.className="check";
  var c=document.createElement("input");c.type="checkbox";c.id="todo"+i;c.checked=!!done[i];
  var l=document.createElement("label");l.htmlFor=c.id;l.textContent=t;
  c.addEventListener("change",function(){done[i]=c.checked;try{localStorage.setItem(KEY,JSON.stringify(done))}catch(e){}prog()});
  d.appendChild(c);d.appendChild(l);td.appendChild(d);
});
function prog(){
  var n=TODO.filter(function(_,i){return done[i]}).length,pc=Math.round(n/TODO.length*100);
  $("barFill").style.width=pc+"%";$("barWrap").setAttribute("aria-valuenow",pc);
  $("barTxt").textContent=TODO.length+"개 중 "+n+"개 했어요";
}
prog();

/* ---------- start ---------- */
var h=(location.hash||"").slice(1);
show(CH.some(function(c){return c[0]===h})?h:"start",false);
})();
</script>
